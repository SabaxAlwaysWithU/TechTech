---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonSteps from '../../../components/LessonSteps.astro';
import { getLessons, getField } from '../../../lib/content';

export async function getStaticPaths() {
  const lessons = await getLessons();
  const articles = await getCollection('articles');
  return lessons.map((l) => ({
    params: { field: l.field, lesson: l.slug },
    props: { lesson: l, article: articles.find((a) => a.id === l.id)!, next: lessons.find((x) => x.field === l.field && x.number === l.number + 1) ?? null },
  }));
}
const { lesson, article, next } = Astro.props;
const field = getField(lesson.field)!;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const practiceHref = `${base}/${lesson.field}/${lesson.slug}/practice/`;
const quizHref = `${base}/${lesson.field}/${lesson.slug}/quiz/`;
// 練習場に渡すときのパラメータ名(SQLは ?sql=、HTMLは ?code=)
const param = field.practice === 'sql' ? 'sql' : 'code';
const stepProps = {
  lessonId: lesson.id, field: lesson.field, slug: lesson.slug, number: lesson.number, title: lesson.title,
  quizCount: lesson.quiz.length, taskCount: lesson.tasks.length,
  nextHref: next ? `${base}/${next.field}/${next.slug}/` : `${base}/${lesson.field}/`,
  nextLabel: next ? `次のレッスン: ${next.title}` : 'レッスン一覧へ',
};
---
<Base title={`${lesson.title} — ${field.title}`}>
  <LessonSteps {...stepProps} current="article" />
  <main class="prose article" data-lesson={lesson.id} data-practice={practiceHref} data-param={param} data-languages={field.languages.join(',')}>
    <p class="eyebrow muted"><a href={`${base}/${lesson.field}/`}>{field.title}</a> · レッスン{lesson.number}</p>
    <h1>{lesson.title}</h1>
    <Content />
    <hr />
    <p class="muted">記事を読み終えたら、クイズで確かめましょう。</p>
    <p id="next-steps">
      <a class="btn" href={quizHref}>クイズへ進む</a>
      <a class="btn secondary" href={`${practiceHref}?from=next-steps`}>練習場へ</a>
    </p>
  </main>

  <script>
    import { markRead } from '../../../lib/progress';
    const main = document.querySelector<HTMLElement>('main.article')!;
    markRead(main.dataset.lesson!);

    // 分野の言語のコード例に「練習場で試す」ボタンを付ける
    const practice = main.dataset.practice!;
    const param = main.dataset.param!;
    const languages = main.dataset.languages!.split(',');
    // 各コード例に id を付け、練習場から戻るときにその場所へ戻れるようにする(?from=id)
    let n = 0;
    for (const pre of main.querySelectorAll<HTMLElement>('pre[data-language]')) {
      if (!languages.includes(pre.dataset.language!)) continue;
      const code = pre.textContent?.trim() ?? '';
      if (!code) continue;
      const id = `try-${++n}`;
      pre.id = id;
      const wrap = document.createElement('div');
      wrap.className = 'try';
      const a = document.createElement('a');
      a.href = `${practice}?${param}=${encodeURIComponent(code)}&from=${id}`;
      a.textContent = '練習場で試す →';
      wrap.appendChild(a);
      pre.insertAdjacentElement('afterend', wrap);
    }
  </script>

  <style>
    .eyebrow { font-size: 0.85rem; margin: 0 0 0.5rem; }
    .eyebrow a { color: var(--muted); text-decoration: none; }
    :global(.try) { text-align: right; font-size: 0.85rem; margin: -0.8rem 0 1.5rem; }
    .article :global(pre) { margin-bottom: 1.2rem; scroll-margin-top: 5rem; }
    #next-steps { scroll-margin-top: 5rem; }
    .article :global(h2) { border-bottom: 1px solid var(--line); padding-bottom: 0.3rem; }
    .article :global(h3) { font-size: 1.05rem; margin: 2rem 0 0.6rem; }
    .article :global(ul), .article :global(ol) { padding-left: 1.5rem; margin: 0 0 1.2rem; }
    .article :global(li) { margin-bottom: 0.3rem; }
    .article :global(blockquote) { margin: 0 0 1.2rem; padding: 0.2rem 1rem; border-left: 3px solid var(--line); color: var(--muted); }
    .article :global(strong) { font-weight: 600; }
  </style>
</Base>
