---
import Base from '../../layouts/Base.astro';
import { getFields, getLessons } from '../../lib/content';

export async function getStaticPaths() {
  const fields = getFields();
  return Promise.all(
    fields.map(async (f) => ({ params: { field: f.id }, props: { field: f, lessons: await getLessons(f.id) } })),
  );
}
const { field, lessons } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${field.title} — PC基礎学習`}>
  <main class="prose">
    <h1>{field.title}</h1>
    <p class="muted">{field.description}</p>
    <p class="muted">レッスンは順に並んでいますが、どこからでも始められます。各レッスンは「記事を読む → クイズに答える → 練習場で打つ」の3ステップです。</p>
    <ul class="lesson-list">
      {lessons.map((l) => (
        <li data-lesson={l.id} data-quiz={l.quiz.length} data-tasks={l.tasks.length}>
          <span class="num">{l.number}</span>
          <div style="flex: 1; min-width: 0;">
            <a href={`${base}/${l.field}/${l.slug}/`}>{l.title}</a>
            <span class="desc">{l.description}</span>
            <span class="status muted" data-status></span>
          </div>
        </li>
      ))}
    </ul>
    <p style="margin-top: 2rem;"><a href={`${base}/${field.id}/practice/`}>練習場(フリーモード)を開く</a></p>
  </main>

  <script>
    import { getProgress, lessonScore } from '../../lib/progress';
    for (const li of document.querySelectorAll<HTMLElement>('[data-lesson]')) {
      const p = getProgress(li.dataset.lesson!);
      const quiz = Number(li.dataset.quiz);
      const tasks = Number(li.dataset.tasks);
      const parts: string[] = [];
      parts.push(p.read ? '記事: 読了' : '記事: 未読');
      if (quiz) parts.push(p.quizBest != null ? `クイズ: ${p.quizBest}/${quiz}` : 'クイズ: 未挑戦');
      if (tasks) {
        const done = Object.values(p.tasks ?? {}).filter(Boolean).length;
        parts.push(`練習: ${done}/${tasks}`);
      }
      const el = li.querySelector<HTMLElement>('[data-status]')!;
      el.textContent = parts.join(' · ');
      if (lessonScore(p, quiz, tasks) === 3) li.classList.add('complete');
    }
  </script>

  <style>
    .status { display: block; font-size: 0.8rem; margin-top: 0.3rem; }
    .lesson-list li.complete { border-color: var(--accent); }
    .lesson-list li.complete .num { color: var(--accent); }
    .lesson-list li.complete .num::after { content: ' ✓'; }
  </style>
</Base>
