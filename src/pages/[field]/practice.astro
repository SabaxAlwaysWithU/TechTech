---
import Base from '../../layouts/Base.astro';
import Practice from '../../components/Practice.astro';
import HtmlPractice from '../../components/HtmlPractice.astro';
import JsPractice from '../../components/JsPractice.astro';
import ShellPractice from '../../components/ShellPractice.astro';
import StackPractice from '../../components/StackPractice.astro';
import { getFields, getCatalog } from '../../lib/content';

export function getStaticPaths() {
  return getFields().map((f) => ({ params: { field: f.id }, props: { field: f } }));
}
const { field } = Astro.props;
---
<Base title={`練習場 — ${field.title}`} wide>
  {field.practice === 'html' && <HtmlPractice />}
  {field.practice === 'js' && <JsPractice />}
  {field.practice === 'shell' && <ShellPractice />}
  {field.practice === 'stack' && <StackPractice catalog={getCatalog(field.id)!} />}
  {field.practice === 'sql' && <Practice />}
</Base>
