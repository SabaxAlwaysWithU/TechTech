---
// ネットワークの練習場: 図の部品をクリックして壊したり直したりし、下のターミナルでコマンドを打って確かめる。
import type { Task } from '../lib/content';
interface Props {
  lessonId?: string;
  lessonTitle?: string;
  tasks?: Task[];
  backHref?: string;
  nextHref?: string;
  nextLabel?: string;
}
const { lessonId, lessonTitle, tasks = [], backHref, nextHref, nextLabel } = Astro.props;
const hasTasks = tasks.length > 0;
// 図に置く部品。x, y は 0〜100 の割合
const nodes = [
  { id: 'pc', label: 'PC', sub: '192.168.1.10', x: 8, y: 50, parts: ['ipconfig'] },
  { id: 'router', label: 'ルーター', sub: '192.168.1.1', x: 32, y: 50, parts: ['router'] },
  { id: 'internet', label: 'インターネット', sub: 'プロバイダ', x: 56, y: 50, parts: ['wan'] },
  { id: 'dns', label: 'DNS', sub: '8.8.8.8', x: 84, y: 20, parts: ['dns'] },
  { id: 'server', label: 'Webサーバー', sub: 'nginx → アプリ → DB', x: 84, y: 80, parts: ['server', 'port', 'cert', 'app', 'db'] },
];
const links = [
  { id: 'cable', from: 'pc', to: 'router', label: 'ケーブル / Wi-Fi' },
  { id: 'wan', from: 'router', to: 'internet', label: '回線' },
  { id: 'l-dns', from: 'internet', to: 'dns', label: '' },
  { id: 'l-srv', from: 'internet', to: 'server', label: '' },
];
const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
---
<main class="practice">
  <div class="pane left">
    <section class="task">
      {hasTasks ? (
        <>
          <p class="eyebrow">{lessonTitle} の練習</p>
          <nav class="task-tabs" id="task-tabs" aria-label="課題">
            {tasks.map((t, i) => (
              <button type="button" class="tab" data-index={i} aria-current={i === 0 ? 'true' : undefined}>課題{i + 1}</button>
            ))}
          </nav>
          <h1 id="task-title">{tasks[0].title}</h1>
          <div id="task-text" class="task-text" set:html={tasks[0].text} />
          <div class="hints">
            <button type="button" class="btn secondary" id="hint-btn">ヒントを見る</button>
            <ol id="hint-list" class="hint-list"></ol>
            <details id="answer-box" hidden>
              <summary>模範解答を見る</summary>
              <pre id="answer-code"></pre>
            </details>
          </div>
          <div id="verdict" class="verdict" hidden></div>
        </>
      ) : (
        <>
          <h1>フリーモード</h1>
          <p class="muted">課題はありません。図の部品をクリックして壊したり直したりしながら、下のターミナルで <code>ping</code> や <code>curl</code> を打ってみてください。<code>help</code> でコマンドの一覧が見られます。</p>
        </>
      )}
    </section>
    <section class="parts">
      <h2>部品の状態</h2>
      <ul id="part-list" class="part-list"></ul>
    </section>
  </div>
  <div class="pane right">
    <section class="diagram-wrap">
      <div class="bar">
        <span class="label">ネットワーク図</span>
        <span class="muted small">(部品や線をクリックすると壊れる / 直る)</span>
        <button id="reset" class="btn secondary small-btn" type="button">全部直す</button>
      </div>
      <svg id="diagram" class="diagram" viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="ネットワーク図">
        {links.map((l) => (
          <g class="link" data-part={l.id === 'cable' ? 'cable' : l.id === 'wan' ? 'wan' : ''} data-link={l.id}>
            <line x1={pos[l.from].x} y1={pos[l.from].y} x2={pos[l.to].x} y2={pos[l.to].y} class="wire" />
            <line x1={pos[l.from].x} y1={pos[l.from].y} x2={pos[l.to].x} y2={pos[l.to].y} class="wire-hit" />
            {l.label && (
              <text x={(pos[l.from].x + pos[l.to].x) / 2} y={(pos[l.from].y + pos[l.to].y) / 2 - 6} class="wire-label" text-anchor="middle">{l.label}</text>
            )}
          </g>
        ))}
      </svg>
      <div class="nodes" id="nodes">
        {nodes.map((n) => (
          <button type="button" class="node" data-node={n.id} data-parts={n.parts.join(',')} style={`left:${n.x}%; top:${n.y}%`}>
            <span class="node-label">{n.label}</span>
            <span class="node-sub">{n.sub}</span>
            <span class="node-state" data-state></span>
          </button>
        ))}
      </div>
      <div id="menu" class="menu" hidden></div>
    </section>
    <section class="terminal-wrap">
      <div class="bar"><span class="label">ターミナル</span><span class="muted small">(↑↓ で履歴)</span></div>
      <div id="terminal" class="terminal" tabindex="0">
        <pre id="screen" class="screen"></pre>
        <div class="input-line">
          <span class="prompt">saba@pc:~$ </span>
          <input id="cmd" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="コマンド入力" />
        </div>
      </div>
    </section>
    {hasTasks && (
      <nav class="lesson-nav">
        {backHref && <a href={backHref} data-back>← 記事に戻る</a>}
        {nextHref && <a href={nextHref}>{nextLabel ?? '次へ'} →</a>}
      </nav>
    )}
  </div>
</main>

<script type="application/json" id="practice-data" set:html={JSON.stringify({ lessonId, tasks })} />

<script>
  import { createNet, exec, toggle, judgeNet, healthy, PARTS, type NetState, type Part } from '../lib/netsim';
  import { getProgress, markTaskCleared } from '../lib/progress';
  import type { Task } from '../lib/content';

  const data = JSON.parse(document.getElementById('practice-data')!.textContent!) as { lessonId?: string; tasks: Task[] };
  const tasks = data.tasks;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const screen = $('screen');
  const input = $<HTMLInputElement>('cmd');
  const terminal = $('terminal');
  const menu = $('menu');
  const partList = $('part-list');
  let state: NetState = createNet();
  let taskIndex = 0;
  let hintsShown = 0;
  let histPos = -1;
  let hideStatus = false;
  const WELCOME = 'ネットワーク練習場。help でコマンドの一覧が見られます。\n';

  function currentTask(): Task | undefined { return tasks[taskIndex]; }

  function append(text: string) {
    screen.textContent += text;
    terminal.scrollTop = terminal.scrollHeight;
  }

  // ---- 図と一覧の描画 ----
  function render() {
    for (const el of document.querySelectorAll<HTMLElement>('[data-node]')) {
      const parts = el.dataset.parts!.split(',') as Part[];
      const broken = parts.some((p) => !state[p]);
      el.classList.toggle('broken', !hideStatus && broken);
      el.classList.toggle('unknown', hideStatus);
      el.querySelector('[data-state]')!.textContent = hideStatus ? '?' : broken ? '故障' : '正常';
    }
    for (const el of document.querySelectorAll<SVGGElement>('.link')) {
      const p = el.dataset.part as Part | '';
      const broken = p ? !state[p] : false;
      el.classList.toggle('broken', !hideStatus && broken);
      el.classList.toggle('unknown', hideStatus && !!p);
    }
    partList.innerHTML = '';
    for (const p of PARTS) {
      const li = document.createElement('li');
      li.className = state[p.id] ? 'ok' : 'ng';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'part-btn';
      const status = hideStatus ? '?' : state[p.id] ? '正常' : '故障';
      btn.innerHTML = `<span class="part-status"></span><span class="part-name"></span><span class="part-desc muted small"></span>`;
      btn.querySelector('.part-status')!.textContent = status;
      btn.querySelector('.part-name')!.textContent = p.label;
      btn.querySelector('.part-desc')!.textContent = hideStatus ? p.where : state[p.id] ? p.fixed : p.broken;
      btn.addEventListener('click', () => flip(p.id));
      li.appendChild(btn);
      partList.appendChild(li);
    }
  }

  function flip(part: Part) {
    toggle(state, part);
    const p = PARTS.find((x) => x.id === part)!;
    append(`# ${p.label}: ${state[part] ? '直した' : '壊した'}(${state[part] ? p.fixed : p.broken})\n`);
    render();
    judge();
  }

  // 部品をクリックしたときのメニュー(ノードに複数の部品があるとき用)
  function openMenu(anchor: HTMLElement, parts: Part[]) {
    if (parts.length === 1) { flip(parts[0]); return; }
    menu.innerHTML = '';
    for (const id of parts) {
      const p = PARTS.find((x) => x.id === id)!;
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = `${p.label}: ${hideStatus ? '切り替える' : state[id] ? '壊す' : '直す'}`;
      b.addEventListener('click', () => { flip(id); menu.hidden = true; });
      menu.appendChild(b);
    }
    const r = anchor.getBoundingClientRect();
    const wrap = anchor.closest<HTMLElement>('.diagram-wrap')!.getBoundingClientRect();
    menu.style.left = `${r.left - wrap.left}px`;
    menu.style.top = `${r.bottom - wrap.top + 4}px`;
    menu.hidden = false;
  }

  document.getElementById('nodes')!.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-node]');
    if (!el) return;
    e.stopPropagation();
    openMenu(el, el.dataset.parts!.split(',') as Part[]);
  });
  document.getElementById('diagram')!.addEventListener('click', (e) => {
    const g = (e.target as Element).closest<SVGGElement>('.link');
    if (!g || !g.dataset.part) return;
    flip(g.dataset.part as Part);
  });
  document.addEventListener('click', () => { menu.hidden = true; });

  // ---- 判定 ----
  function judge() {
    const t = currentTask();
    if (!t || !t.netChecks) return;
    const j = judgeNet(state, t.netChecks as any);
    const verdict = $('verdict');
    if (j.correct) {
      verdict.hidden = false;
      verdict.className = 'verdict correct';
      verdict.textContent = '正解です。';
      if (data.lessonId) markTaskCleared(data.lessonId, t.id);
      document.querySelector<HTMLButtonElement>(`#task-tabs .tab[data-index="${taskIndex}"]`)?.classList.add('done');
      if (hideStatus) { hideStatus = false; render(); }
    } else if (!verdict.hidden && verdict.classList.contains('correct')) {
      // 正解済みなら表示は残す
    } else {
      verdict.hidden = false;
      verdict.className = 'verdict wrong';
      verdict.textContent = `まだです: ${j.message}`;
    }
  }

  function run(line: string) {
    append(`saba@pc:~$ ${line}\n`);
    const out = exec(state, line);
    if (out === '\u0000clear') screen.textContent = '';
    else if (out) append(out + '\n');
    histPos = -1;
    judge();
  }

  function resetNet(applyFaults: boolean) {
    state = createNet();
    const t = currentTask();
    hideStatus = !!(t?.hideStatus && applyFaults);
    if (applyFaults && t?.faults) for (const f of t.faults) state[f as Part] = false;
    screen.textContent = WELCOME + (applyFaults && t?.faults?.length ? (hideStatus ? '# どこかが壊れています。コマンドで調べて、直してください。\n' : '# この課題の開始状態では、いくつかの部品が壊れています。\n') : '');
    render();
  }

  function renderTask() {
    const t = currentTask();
    if (!t) return;
    hintsShown = 0;
    $('task-title').textContent = t.title;
    $('task-text').innerHTML = t.text;
    $('hint-list').innerHTML = '';
    const hintBtn = $<HTMLButtonElement>('hint-btn');
    hintBtn.hidden = t.hints.length === 0;
    hintBtn.textContent = 'ヒントを見る';
    const ans = $<HTMLDetailsElement>('answer-box');
    ans.hidden = true;
    ans.open = false;
    $('answer-code').textContent = t.answer ?? '';
    const verdict = $('verdict');
    verdict.hidden = true;
    verdict.className = 'verdict';
    const prog = data.lessonId ? getProgress(data.lessonId) : {};
    for (const tab of document.querySelectorAll<HTMLButtonElement>('#task-tabs .tab')) {
      const i = Number(tab.dataset.index);
      tab.toggleAttribute('aria-current', i === taskIndex);
      tab.classList.toggle('done', !!prog.tasks?.[tasks[i].id]);
    }
    if (prog.tasks?.[t.id]) { verdict.hidden = false; verdict.classList.add('correct'); verdict.textContent = 'クリア済み。もう一度やってみても構いません。'; }
    resetNet(true);
    input.focus();
  }

  function showHint() {
    const t = currentTask();
    if (!t) return;
    if (hintsShown < t.hints.length) {
      const li = document.createElement('li');
      li.textContent = t.hints[hintsShown];
      $('hint-list').appendChild(li);
      hintsShown++;
    }
    const btn = $<HTMLButtonElement>('hint-btn');
    if (hintsShown >= t.hints.length) {
      btn.hidden = true;
      $('answer-box').hidden = false;
    } else {
      btn.textContent = `次のヒントを見る(${hintsShown}/${t.hints.length})`;
    }
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { const line = input.value; input.value = ''; run(line); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); const h = state.history; if (!h.length) return; histPos = histPos < 0 ? h.length - 1 : Math.max(0, histPos - 1); input.value = h[histPos]; }
    else if (e.key === 'ArrowDown') { e.preventDefault(); const h = state.history; if (histPos < 0) return; histPos = histPos + 1 >= h.length ? -1 : histPos + 1; input.value = histPos < 0 ? '' : h[histPos]; }
  });
  terminal.addEventListener('click', () => input.focus());
  $('reset').addEventListener('click', () => { resetNet(false); append('# 全部直しました\n'); judge(); input.focus(); });
  document.getElementById('hint-btn')?.addEventListener('click', showHint);
  document.getElementById('task-tabs')?.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab');
    if (!tab) return;
    taskIndex = Number(tab.dataset.index);
    renderTask();
  });

  const params = new URLSearchParams(location.search);
  const presetTask = Number(params.get('task'));
  if (tasks.length && presetTask >= 1 && presetTask <= tasks.length) taskIndex = presetTask - 1;
  if (tasks.length) renderTask(); else resetNet(false);
  const preset = params.get('code');
  if (preset) for (const line of preset.split('\n')) if (line.trim()) run(line);
  input.focus();
  void healthy;
</script>

<style>
  .practice {
    max-width: 80rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(0, 2.2fr);
    gap: 2rem;
    font-size: 0.95rem;
  }
  @media (max-width: 760px) { .practice { grid-template-columns: 1fr; } }
  .pane { min-width: 0; }
  h1 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  h2 { font-size: 0.85rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin: 2rem 0 0.4rem; font-weight: 600; }
  .eyebrow { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.6rem; }
  .task p { margin: 0 0 1rem; }
  .task-text :global(p) { margin: 0 0 0.8rem; }
  .task-text :global(ul), .task-text :global(ol) { margin: 0 0 0.8rem; padding-left: 1.4rem; }
  .task-text :global(code), .task code { font-family: var(--mono); background: var(--surface); padding: 0.1em 0.35em; font-size: 0.9em; border-radius: 5px; }
  .task-tabs { display: flex; gap: 0.3rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .task-tabs .tab { font: inherit; font-size: 0.85rem; padding: 0.3rem 0.9rem; cursor: pointer; background: transparent; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; }
  .task-tabs .tab:hover { background: var(--surface); }
  .task-tabs .tab[aria-current] { color: var(--fg); border-color: var(--fg); background: var(--surface); }
  .task-tabs .tab.done::after { content: ' ✓'; color: var(--accent); }
  .hints { margin-top: 1rem; }
  .hint-list { margin: 0.8rem 0 0; padding-left: 1.4rem; }
  .hint-list :global(li) { margin-bottom: 0.4rem; }
  details { margin-top: 0.8rem; }
  summary { cursor: pointer; color: var(--accent); }
  #answer-code { font-family: var(--mono); font-size: 0.85rem; background: var(--surface); padding: 0.8rem 1rem; white-space: pre-wrap; margin: 0.5rem 0 0; border-radius: var(--radius-sm); }
  .verdict { margin-top: 1rem; padding: 0.7rem 1rem; border-left: 4px solid var(--line); background: var(--surface); font-weight: 600; border-radius: var(--radius-sm); }
  .verdict.correct { border-left-color: var(--accent); color: var(--accent); }
  .verdict.wrong { border-left-color: var(--muted); font-weight: 500; }
  .small { font-size: 0.8rem; }
  .label { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .bar { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .bar .small-btn { margin-left: auto; font-size: 0.85rem; padding: 0.3rem 0.9rem; }

  /* 部品の一覧 */
  .part-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .part-list :global(.part-btn) {
    display: grid; grid-template-columns: 3.2rem 1fr; grid-template-rows: auto auto; column-gap: 0.6rem; align-items: center;
    width: 100%; text-align: left; font: inherit; color: var(--fg); background: none; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.45rem 0.7rem; cursor: pointer;
  }
  .part-list :global(.part-btn:hover) { background: var(--surface); }
  .part-list :global(.part-status) { grid-row: 1 / 3; font-size: 0.75rem; font-weight: 700; text-align: center; padding: 0.15rem 0; border-radius: 999px; background: var(--surface); }
  .part-list :global(li.ok .part-status) { color: var(--accent); }
  .part-list :global(li.ng .part-status) { color: #fff; background: var(--error); }
  .part-list :global(.part-name) { font-weight: 600; font-size: 0.9rem; }
  .part-list :global(.part-desc) { font-size: 0.78rem; }

  /* 図 */
  .diagram-wrap { position: relative; }
  .diagram { width: 100%; height: 15rem; display: block; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .wire { stroke: var(--muted); stroke-width: 0.6; vector-effect: non-scaling-stroke; stroke-width: 3px; }
  .wire-hit { stroke: transparent; stroke-width: 14px; vector-effect: non-scaling-stroke; cursor: pointer; }
  .link.broken .wire { stroke: var(--error); stroke-dasharray: 6 6; }
  .link.unknown .wire { stroke-dasharray: 2 4; }
  .wire-label { font-size: 3.2px; fill: var(--muted); pointer-events: none; }
  .nodes { position: absolute; inset: 0; height: 15rem; pointer-events: none; }
  .node {
    position: absolute; transform: translate(-50%, -50%); pointer-events: auto;
    font: inherit; cursor: pointer; text-align: center;
    background: var(--bg); color: var(--fg); border: 2px solid var(--muted); border-radius: var(--radius-sm);
    padding: 0.4rem 0.7rem; min-width: 6.5rem; line-height: 1.3;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .node:hover { box-shadow: 0 0 0 3px var(--surface); }
  .node-label { display: block; font-weight: 600; font-size: 0.85rem; }
  .node-sub { display: block; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); }
  .node-state { display: inline-block; margin-top: 0.25rem; font-size: 0.7rem; font-weight: 700; color: var(--accent); }
  .node.broken { border-color: var(--error); }
  .node.broken .node-state { color: #fff; background: var(--error); padding: 0 0.5rem; border-radius: 999px; }
  .node.unknown { border-style: dashed; }
  .node.unknown .node-state { color: var(--muted); }
  .menu { position: absolute; z-index: 5; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.3rem; display: flex; flex-direction: column; gap: 0.2rem; box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
  .menu :global(button) { font: inherit; font-size: 0.85rem; text-align: left; background: none; border: 0; padding: 0.35rem 0.7rem; cursor: pointer; color: var(--fg); border-radius: 5px; }
  .menu :global(button:hover) { background: var(--surface); }

  /* ターミナル */
  .terminal-wrap { margin-top: 1.2rem; }
  .terminal {
    background: #15181c; color: #e6e6e6; font-family: var(--mono); font-size: 0.88rem; line-height: 1.55;
    border-radius: var(--radius); border: 1px solid #2b3036; padding: 0.9rem 1rem; height: 16rem; overflow-y: auto; cursor: text;
  }
  .terminal:focus-within { outline: 2px solid var(--accent); outline-offset: -1px; }
  .screen { margin: 0; white-space: pre-wrap; word-break: break-all; font: inherit; }
  .input-line { display: flex; align-items: baseline; }
  .prompt { color: #7ddba3; white-space: pre; flex: none; }
  #cmd { flex: 1; min-width: 0; font: inherit; color: inherit; background: transparent; border: 0; outline: none; padding: 0; caret-color: #e6e6e6; }
  .lesson-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
</style>
