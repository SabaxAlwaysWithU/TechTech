---
import '../styles/global.css';
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 上のバーは大きな入口だけ。分野やレッスンの一覧はページの中で見せる
const path = Astro.url.pathname.replace(base, '');
const nav = [
  { href: `${base}/`, label: 'レッスン', current: !path.startsWith('/settings') },
  { href: `${base}/settings/`, label: '設定', current: path.startsWith('/settings') },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner" style={wide ? 'max-width: 80rem' : ''}>
        <a class="brand" href={`${base}/`}>techtech</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <script>
      // ?from=<id> 付きで開かれたページでは、「戻る」リンク(data-back)の先に #<id> を付けて、
      // 押した場所へ戻れるようにする
      const from = new URLSearchParams(location.search).get('from');
      if (from && /^[\w-]+$/.test(from)) {
        for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-back]')) {
          a.href = a.href.split('#')[0] + '#' + from;
        }
      }
    </script>
  </body>
</html>
