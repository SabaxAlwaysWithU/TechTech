  {
    "id": "lazy",
    "title": "できるだけ短く",
    "text": "<p>下の文章から、HTML のタグ(<code>&lt;b&gt;</code> や <code>&lt;/b&gt;</code>)を1つずつ取り出してください。今のパターンは欲張りで、長く一致しすぎています。</p>",
    "starter": "<.+>",
    "answer": "<.+?>",
    "hints": [
      "くり返しはできるだけ長く一致します。短くするには、くり返しの記号のあとに ? を付けます。",
      "<.+?>"
    ],
    "regex": {
      "extract": {
        "text": "<b>太字</b>と<i>斜体</i>",
