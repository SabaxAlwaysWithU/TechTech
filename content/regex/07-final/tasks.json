[
  {
    "id": "member",
    "title": "1 会員番号",
    "text": "<p>会員番号は「大文字の <code>M</code> のあとに数字がちょうど5けた」です。入力チェックのパターンを書いてください(全体一致で調べます)。</p>",
    "starter": "",
    "answer": "M\\d{5}",
    "hints": [
      "M のあとに \\d が5回です。",
      "M\\d{5}"
    ],
    "regex": {
      "full": true,
      "match": [
        "M12345",
        "M00001"
      ],
      "noMatch": [
        "M1234",
        "M123456",
        "m12345",
        "XM12345"
      ]
    }
  },
  {
    "id": "orders",
    "title": "2 注文番号を取り出す",
    "text": "<p>問い合わせの文から、注文番号(<code>A-</code> のあとに数字)を全部取り出してください。<code>B-</code> で始まる番号は取り出しません。</p>",
    "starter": "",
    "answer": "A-\\d+",
    "hints": [
      "A- はそのまま書きます。数字は何けたでもよいので \\d+ です。",
      "A-\\d+"
    ],
    "regex": {
      "extract": {
        "text": "注文 A-1001 と A-1002 の件です。B-2001 は別のお店の番号です。",
        "expect": [
          "A-1001",
          "A-1002"
        ]
      }
    }
  },
  {
    "id": "date",
    "title": "3 日付をそろえる",
    "text": "<p><code>2026/11/25</code> の形の日付を <code>2026-11-25</code> にそろえてください。置き換える文字は <code>$1-$2-$3</code> です。</p>",
    "starter": "/",
    "answer": "(\\d{4})/(\\d{2})/(\\d{2})",
    "hints": [
      "年・月・日をそれぞれグループにします。",
      "(\\d{4})/(\\d{2})/(\\d{2})"
    ],
    "regex": {
      "replace": {
        "text": "発送 2026/11/25、到着 2026/12/01(A/B 2便)",
        "with": "$1-$2-$3",
        "expect": "発送 2026-11-25、到着 2026-12-01(A/B 2便)"
      }
    }
  },
  {
    "id": "mask",
    "title": "4 メールを隠す",
    "text": "<p>メールアドレスの @ より前を <code>***</code> に隠してください。置き換える文字は <code>***@</code> です(@ も一緒に一致させて、置き換え先で戻します)。</p>",
    "starter": "",
    "answer": "[\\w.+-]+@",
    "hints": [
      "@ の前の部分は [\\w.+-]+ で、そのあとに @ を付けます。",
      "[\\w.+-]+@"
    ],
    "regex": {
      "replace": {
        "text": "連絡先: taro@example.com, hanako.y@example.jp",
        "with": "***@",
        "expect": "連絡先: ***@example.com, ***@example.jp"
      }
    }
  },
  {
    "id": "amount",
    "title": "5 金額の入力チェック",
    "text": "<p>金額の入力チェックです。カンマなし(<code>2500</code>)でも、3けたごとのカンマあり(<code>2,500</code>、<code>12,345,678</code>)でもよく、カンマの位置がおかしいものははじきます(全体一致で調べます)。</p>",
    "starter": "",
    "answer": "\\d+|\\d{1,3}(,\\d{3})+",
    "hints": [
      "2つの書き方を | でつなぎます。カンマなしは \\d+ です。",
      "カンマありは \\d{1,3}(,\\d{3})+。全体で \\d+|\\d{1,3}(,\\d{3})+"
    ],
    "regex": {
      "full": true,
      "match": [
        "2500",
        "2,500",
        "32,000",
        "12,345,678",
        "0"
      ],
      "noMatch": [
        "2,50",
        ",500",
        "1,2345",
        "25,00",
        "abc"
      ]
    }
  }
]
